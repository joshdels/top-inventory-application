<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Songs</title>
  </head>
  <body>

    <%- include('navigation') %> 

    <h1>Songs' Genres</h1>

    <% if (genres && genres.length) { %>
        <% genres.forEach((genre) => { %>

          <a class="card" href="songs/<%= genre.genre %>">
            <h1><%= genre.genre %></h1>
          </a>

        <% }) %>

    <% } else { %>
      <p>No genres found</p>
    <% } %>



  </body>
</html>
